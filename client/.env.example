# ---------------------------------------------------------------------------
# Discord OAuth
# ---------------------------------------------------------------------------
# https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must match the "Redirect" registered in the Discord developer portal exactly.
# The default deployment keeps the callback at /api for backwards compatibility.
DISCORD_REDIRECT_URI=https://learntk.vercel.app/api

# ---------------------------------------------------------------------------
# Course entitlement
# ---------------------------------------------------------------------------
# Server that owns membership.
DISCORD_GUILD_ID=746789586914639933

# Comma separated role ids that unlock the course. Any one is enough.
DISCORD_MEMBER_ROLE_IDS=1059574449025843353

# Per-course roles. Falling back to DISCORD_MEMBER_ROLE_IDS for the beginner
# course means existing members keep their access.
DISCORD_ROLE_24B=1059574449025843353
# Leave empty until the advanced course has its own role; nobody owns it then.
DISCORD_ROLE_ADVANCED=

# Comma separated role ids for instructors/admins. Optional.
DISCORD_ADMIN_ROLE_IDS=

# Where "Join the community server" points to.
DISCORD_INVITE_URL=https://discord.gg/your-invite

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(crypto.randomBytes(48).toString('hex'))"
# If unset, a key is derived from DISCORD_CLIENT_SECRET (works, but rotating the
# Discord secret then signs everybody out).
SESSION_SECRET=

# Absolute origin, used for canonical URLs.
SITE_URL=https://learntk.vercel.app

# ---------------------------------------------------------------------------
# Optional: durable progress storage
# ---------------------------------------------------------------------------
# Public Firebase web config as JSON. Used as a best-effort mirror for lesson
# progress. Leave empty to keep progress in the signed session cookie only.
FIREBASE=
