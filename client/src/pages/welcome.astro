---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { setSessionCookie } from "../lib/session";
import { saveProfile } from "../lib/store";

// The middleware guarantees a signed-in member reaches this page.
const session = Astro.locals.session;
if (!session) {
  return Astro.redirect("/access-denied?reason=not_signed_in&next=/welcome", 302);
}

const currentName = session.certificateName ?? session.displayName;
let error = "";

if (Astro.request.method === "POST") {
  const data = await Astro.request.formData().catch(() => null);
  const name = String(data?.get("name") ?? "").trim();

  if (name.length < 3) {
    error = "Please enter the full name you would like printed on your certificate.";
  } else if (name.length > 80) {
    error = "That name is too long. Please use 80 characters or fewer.";
  } else {
    const saved = await saveProfile(session.sub, { certificateName: name });
    if (!saved) {
      // Persisting failed, but the signed cookie still carries the name for
      // this session, so the learner is not blocked.
      console.warn("[onboarding] could not persist certificate name");
    }
    await setSessionCookie(
      Astro.cookies,
      { ...session, certificateName: name },
      { url: new URL(Astro.request.url) },
    );
    return Astro.redirect("/course", 302);
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Welcome · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="mx-auto max-w-xl px-6 py-24">
      <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-gray-500">One quick step</p>
      <h1 class="mb-3 text-4xl font-bold">Let's set up your certificate</h1>
      <p class="mb-8 text-gray-600">
        Tell us the name to print on your certificate of completion. You can change it later.
      </p>

      <form method="POST" class="space-y-6 rounded-2xl border border-gray-200 p-6 shadow-sm">
        <div>
          <label class="mb-2 block text-sm font-medium" for="name">Name on certificate</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            minlength="3"
            maxlength="80"
            value={currentName}
            class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-gray-900 focus:outline-none"
          />
        </div>

        <div>
          <p class="text-sm font-medium">Contact email</p>
          <p class="text-sm text-gray-600">
            {session.email ?? "Your Discord account has no verified email address."}
          </p>
          <p class="mt-1 text-xs text-gray-500">Taken from Discord, so there is nothing extra to type.</p>
        </div>

        {error && <p class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800">{error}</p>}

        <button
          type="submit"
          class="w-full rounded-lg bg-gray-900 px-5 py-3 font-medium text-white transition hover:bg-gray-700"
        >
          Save and continue
        </button>
      </form>

      <p class="mt-6 text-sm text-gray-500">
        Signed in as <strong>{session.displayName}</strong> ·
        <a class="underline" href="/api/logout">Use a different account</a>
      </p>
    </main>
  </body>
</html>
