---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { courses, ownsCourse } from "../data/courses";

const session = Astro.locals.session;

const forSale = courses
  .filter((course) => course.purchase)
  .map((course) => ({
    course,
    owned: Boolean(session && ownsCourse(session.courses, course.slug)),
  }));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Courses · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <script
      is:inline
      src="https://www.paypal.com/sdk/js?client-id=BAAECXx62SA0CIhFnFf-Q-wxmD83XXK-OGZU_M_hXpHjVLNch06nwKsxyGo1Oav3eFTeYPXCLIz8niuiuI&components=hosted-buttons&disable-funding=venmo&currency=GBP"
    ></script>
  </head>
  <body>
    <Header />
    <main>
      {
        !session && (
          <p class="signin-hint">
            Already enrolled? <a href="/api/login?next=%2Fbuy">Sign in with Discord</a> and your
            courses will show as bought here.
          </p>
        )
      }

      {
        forSale.map(({ course, owned }) => (
          <section class="course-card">
            <h1>{course.title}</h1>
            <p class="lede">{course.purchase!.description}</p>

            <ul class="meta">
              {course.purchase!.meta.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <ul class="outcomes">
              {course.outcomes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            {owned ? (
              <div class="owned">
                <p class="owned-title">
                  <span class="tick" aria-hidden="true">✓</span> You already own this course
                </p>
                <p class="owned-body">
                  It is attached to your Discord account, so there is nothing left to pay.
                </p>
                <a class="btn btn-own" href={course.startHref}>
                  {course.level === "Beginner" ? "Start learning" : "Open the course"} →
                </a>
              </div>
            ) : (
              <div class="course-buy">
                <div id={`paypal-container-${course.purchase!.hostedButtonId}`} class="paypal-slot" />
                <p class="fineprint">Checkout is handled by PayPal.</p>
              </div>
            )}

            <p class="print-note">
              {owned
                ? "You own this course. Open it at learntk.vercel.app/course"
                : "Enrol online at learntk.vercel.app/buy — checkout is handled by PayPal."}
            </p>
          </section>
        ))
      }
    </main>
    <Footer />

    {
      forSale
        .filter(({ owned }) => !owned)
        .map(({ course }) => (
          <script is:inline define:vars={{ id: course.purchase!.hostedButtonId }}>
            if (window.paypal && window.paypal.HostedButtons) {
              window.paypal
                .HostedButtons({ hostedButtonId: id })
                .render(`#paypal-container-${id}`);
            }
          </script>
        ))
    }
  </body>

  <style>
    main {
      width: min(1080px, calc(100% - 2rem));
      max-width: none;
      margin: 0 auto;
      padding: 4rem 0 6rem;
      display: grid;
      gap: 2rem;
    }

    .signin-hint {
      margin: 0;
      padding: 0.9rem 1.1rem;
      border: 1px solid rgb(var(--gray-light));
      border-radius: 10px;
      background: #f9fafb;
      font-size: 0.95rem;
      text-align: center;
    }

    .course-card {
      padding: 2.5rem;
      border: 1px solid rgb(var(--gray-light));
      border-radius: 18px;
      background: #fff;
    }

    .course-card h1 {
      margin: 0 0 1rem;
      font-size: 2.2rem;
      line-height: 1.15;
    }

    .lede {
      margin: 0 0 1.5rem;
      max-width: 68ch;
      font-size: 1.05rem;
      line-height: 1.7;
      color: rgb(var(--gray-dark));
    }

    .meta,
    .outcomes {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .meta li {
      padding: 0.3rem 0.75rem;
      border-radius: 999px;
      background: rgb(var(--gray-light));
      color: rgb(var(--gray-dark));
      font-size: 0.85rem;
      line-height: 1.4;
      white-space: nowrap;
    }

    .outcomes {
      margin-top: 1.25rem;
      gap: 0.4rem 1.25rem;
    }

    .outcomes li {
      font-size: 0.95rem;
      color: rgb(var(--gray-dark));
    }

    .outcomes li::before {
      content: "✓";
      margin-right: 0.45rem;
      color: #16a34a;
      font-weight: 700;
    }

    .course-buy {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgb(var(--gray-light));
      text-align: left;
    }

    /* Must stay a plain block: see the note in the git history. PayPal's form
       wrapper uses `container-type: inline-size` and collapses to 0px wide when
       it is a flex or grid item, which forces its narrow layout. */
    .paypal-slot {
      display: block;
      width: 100%;
      min-height: 72px;
    }

    /*
     * PayPal renders its checkout form into our document (not an iframe), so it
     * inherits our typography. global.css sizes h1-h6 with large `em` values,
     * which compounded to a 68px price that wrapped "£19.99 GBP" onto two lines.
     */
    .paypal-slot :global(h1),
    .paypal-slot :global(h2),
    .paypal-slot :global(h3),
    .paypal-slot :global(h4),
    .paypal-slot :global(h5),
    .paypal-slot :global(h6) {
      margin: 0;
      font-size: inherit;
      font-weight: inherit;
      line-height: inherit;
      color: inherit;
    }

    .paypal-slot :global(#price-text),
    .paypal-slot :global(#discount-price) {
      font-size: 1.6rem;
      font-weight: 700;
      line-height: 1.2;
    }

    .paypal-slot :global(iframe) {
      max-width: 100%;
    }

    .fineprint {
      margin: 0.75rem 0 0;
      font-size: 0.8rem;
      line-height: 1.4;
      color: rgb(var(--gray));
      text-align: center;
    }

    .owned {
      margin-top: 2rem;
      padding: 1.5rem;
      border: 1px solid #86efac;
      border-radius: 14px;
      background: #f0fdf4;
      text-align: left;
    }

    .owned-title {
      margin: 0 0 0.35rem;
      font-size: 1.1rem;
      font-weight: 700;
      color: #166534;
    }

    .tick {
      margin-right: 0.4rem;
    }

    .owned-body {
      margin: 0 0 1rem;
      font-size: 0.95rem;
      color: #15803d;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0.65rem 1.25rem;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 500;
      text-decoration: none;
      transition: background-color 0.15s ease;
    }

    .btn-own {
      background: #166534;
      color: #fff;
    }

    .btn-own:hover {
      background: #14532d;
    }

    .print-note {
      display: none;
    }

    @media (max-width: 720px) {
      main {
        padding: 2.5rem 0 4rem;
      }

      .course-card {
        padding: 1.5rem;
      }

      .course-card h1 {
        font-size: 1.8rem;
      }

      .lede {
        font-size: 1rem;
      }

      .btn {
        width: 100%;
      }
    }

    /*
     * A checkout form is useless on paper and, with two of them, it turned a
     * single-page price list into six pages. Print the course details and a
     * short pointer to the live page instead.
     */
    @media print {
      /* Scoped styles cannot reach the Header/Footer components' elements. */
      :global(header),
      :global(footer) {
        display: none !important;
      }

      main {
        display: block;
        width: auto;
        max-width: none;
        padding: 0;
      }

      .signin-hint,
      .course-buy {
        display: none !important;
      }

      .course-card {
        padding: 0 0 1.5rem;
        border: 0;
        border-radius: 0;
        break-inside: avoid;
      }

      .course-card + .course-card {
        padding-top: 1.5rem;
        border-top: 1px solid #ccc;
      }

      .course-card h1 {
        font-size: 20pt;
      }

      .lede {
        font-size: 11pt;
        max-width: none;
      }

      .meta li {
        background: transparent;
        border: 1px solid #999;
        padding: 0.15rem 0.5rem;
      }

      .owned {
        border: 1px solid #999;
        background: transparent;
      }

      .owned .btn {
        display: none;
      }

      .print-note {
        display: block;
        margin: 1rem 0 0;
        font-size: 10pt;
      }
    }
  </style>
</html>
