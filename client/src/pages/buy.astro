---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const courses = [
  {
    title: "Beginner course",
    description:
      "An 7-week introductory course to Python, ideal for those with little to no prior programming experience. By committing only 2 hours per week, you will learn all the skills you need to start making your own Python projects! Sessions are held both in person and online. Also recorded for students who miss a live session. Those attending all the lectures will be rewarded with a certificate of completion, and handing in the final project will be awarded a certificate of commendation. Sign up to start the course this semester!",
    meta: ["7 weeks", "~2 hours per week", "Live + recorded"],
    hostedButtonId: "RMJ7LXNMAHFUN",
  },
  {
    title: "Advanced course",
    description:
      "An 4-week advanced course to Python, ideal for those who just finish the beginner course. The session is only in recording format. Those attending all the lectures will be rewarded with a certificate of completion, and handing in the final project will be awarded a certificate of commendation.",
    meta: ["4 weeks", "Recorded sessions"],
    hostedButtonId: "PUADREGKBLFKQ",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Courses · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <script
      is:inline
      src="https://www.paypal.com/sdk/js?client-id=BAAECXx62SA0CIhFnFf-Q-wxmD83XXK-OGZU_M_hXpHjVLNch06nwKsxyGo1Oav3eFTeYPXCLIz8niuiuI&components=hosted-buttons&disable-funding=venmo&currency=GBP"
    ></script>
  </head>
  <body>
    <Header />
    <main>
      {
        courses.map((course) => (
          <section class="course-card">
            <h1>{course.title}</h1>
            <p class="lede">{course.description}</p>
            <ul class="meta">
              {course.meta.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            {/*
              PayPal's hosted button renders an entire checkout form, not just a
              button. It has to be given the full content width: its wrapper uses
              `container-type: inline-size` and collapses to 0px wide when it is
              a flex/grid item, which forces its narrow layout and makes the
              form ~2000px tall. Plain block flow avoids that.
            */}
            <div class="course-buy">
              <div id={`paypal-container-${course.hostedButtonId}`} class="paypal-slot" />
              <p class="fineprint">Checkout is handled by PayPal.</p>
            </div>

            <p class="print-note">
              Enrol online at <strong>learntk.vercel.app/buy</strong> — checkout is handled by PayPal.
            </p>
          </section>
        ))
      }
    </main>
    <Footer />

    {
      courses.map((course) => (
        <script is:inline define:vars={{ id: course.hostedButtonId }}>
          if (window.paypal && window.paypal.HostedButtons) {
            window.paypal
              .HostedButtons({ hostedButtonId: id })
              .render(`#paypal-container-${id}`);
          }
        </script>
      ))
    }
  </body>

  <style>
    main {
      width: min(1080px, calc(100% - 2rem));
      max-width: none;
      margin: 0 auto;
      padding: 4rem 0 6rem;
      display: grid;
      gap: 2rem;
    }

    .course-card {
      padding: 2.5rem;
      border: 1px solid rgb(var(--gray-light));
      border-radius: 18px;
      background: #fff;
    }

    .course-card h1 {
      margin: 0 0 1rem;
      font-size: 2.2rem;
      line-height: 1.15;
    }

    .lede {
      margin: 0 0 1.5rem;
      max-width: 68ch;
      font-size: 1.05rem;
      line-height: 1.7;
      color: rgb(var(--gray-dark));
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .meta li {
      padding: 0.3rem 0.75rem;
      border-radius: 999px;
      background: rgb(var(--gray-light));
      color: rgb(var(--gray-dark));
      font-size: 0.85rem;
      line-height: 1.4;
      white-space: nowrap;
    }

    .course-buy {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgb(var(--gray-light));
      text-align: left;
    }

    /* Must stay a plain block: see the comment in the markup above. */
    .paypal-slot {
      display: block;
      width: 100%;
      min-height: 72px;
    }

    /*
     * PayPal renders its checkout form into our document (not an iframe), so it
     * inherits our typography. global.css sizes h1-h6 with large `em` values,
     * which compounded to a 68px price that wrapped "£19.99 GBP" onto two lines.
     * Reset headings inside the slot and let PayPal's own sizing apply.
     */
    .paypal-slot :global(h1),
    .paypal-slot :global(h2),
    .paypal-slot :global(h3),
    .paypal-slot :global(h4),
    .paypal-slot :global(h5),
    .paypal-slot :global(h6) {
      margin: 0;
      font-size: inherit;
      font-weight: inherit;
      line-height: inherit;
      color: inherit;
    }

    /* Keep the price readable now that the heading rule no longer inflates it. */
    .paypal-slot :global(#price-text),
    .paypal-slot :global(#discount-price) {
      font-size: 1.6rem;
      font-weight: 700;
      line-height: 1.2;
    }

    /* PayPal injects its own iframe, which scoped styles cannot target. */
    .paypal-slot :global(iframe) {
      max-width: 100%;
    }

    .fineprint {
      margin: 0.75rem 0 0;
      font-size: 0.8rem;
      line-height: 1.4;
      color: rgb(var(--gray));
      text-align: center;
    }

    .print-note {
      display: none;
    }

    @media (max-width: 720px) {
      main {
        padding: 2.5rem 0 4rem;
      }

      .course-card {
        padding: 1.5rem;
      }

      .course-card h1 {
        font-size: 1.8rem;
      }

      .lede {
        font-size: 1rem;
      }
    }

    /*
     * A checkout form is useless on paper and, with two of them, it turned a
     * single-page price list into six pages. Print the course details and a
     * short pointer to the live page instead.
     */
    @media print {
      /* Scoped styles cannot reach the Header/Footer components' elements. */
      :global(header),
      :global(footer) {
        display: none !important;
      }

      main {
        display: block;
        width: auto;
        max-width: none;
        padding: 0;
      }

      .course-card {
        padding: 0 0 1.5rem;
        border: 0;
        border-radius: 0;
        break-inside: avoid;
      }

      .course-card + .course-card {
        padding-top: 1.5rem;
        border-top: 1px solid #ccc;
      }

      .course-card h1 {
        font-size: 20pt;
      }

      .lede {
        font-size: 11pt;
        max-width: none;
      }

      .meta li {
        background: transparent;
        border: 1px solid #999;
        padding: 0.15rem 0.5rem;
      }

      .course-buy {
        display: none !important;
      }

      .print-note {
        display: block;
        margin: 1rem 0 0;
        font-size: 10pt;
      }
    }
  </style>
</html>
