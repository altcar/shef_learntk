---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Page not found · ${SITE_TITLE}`}
      description="That page does not exist."
    />
  </head>
  <body>
    <Header />
    <main class="notfound">
      <p class="code">404</p>
      <h1>We couldn't find that page</h1>
      <p class="body">
        The link may be out of date, or the page may have moved. Here are the
        two places people usually want.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Back to the home page</a>
        <a class="btn btn-secondary" href="/buy">See the courses</a>
      </div>
      <p class="hint">
        Looking for your lessons? <a href="/course">Sign in to your dashboard</a>.
      </p>
    </main>
    <Footer />
  </body>

  <style>
    .notfound {
      width: min(640px, calc(100% - 2rem));
      max-width: none;
      margin: 0 auto;
      padding: 5rem 0 6rem;
      text-align: center;
    }

    .code {
      margin: 0 0 0.5rem;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgb(var(--gray));
    }

    h1 {
      margin: 0 0 1rem;
      font-size: clamp(1.8rem, 5vw, 2.6rem);
      line-height: 1.15;
    }

    .body {
      margin: 0 auto 2rem;
      max-width: 46ch;
      color: rgb(var(--gray-dark));
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0.65rem 1.25rem;
      border: 1px solid transparent;
      border-radius: 8px;
      font-size: 1rem;
      text-decoration: none;
      transition: background-color 0.15s ease;
    }

    .btn-primary {
      background: #111827;
      color: #fff;
    }

    .btn-primary:hover {
      background: #374151;
    }

    .btn-secondary {
      background: #fff;
      border-color: #d1d5db;
      color: #111827;
    }

    .btn-secondary:hover {
      background: #f3f4f6;
    }

    .hint {
      margin: 2.5rem 0 0;
      font-size: 0.9rem;
      color: rgb(var(--gray));
    }

    @media (max-width: 720px) {
      .notfound {
        padding: 3rem 0 4rem;
      }

      .actions {
        flex-direction: column;
      }

      .btn {
        width: 100%;
      }
    }
  </style>
</html>
