---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { courses, completedInCourse, lessonCount, ownsCourse } from '../../data/courses';

// The middleware guarantees an authenticated member here.
const session = Astro.locals.session;
const user = Astro.locals.user;

if (!session || !user) {
  return Astro.redirect('/access-denied?reason=not_signed_in&next=/course', 302);
}

const progress = session.progress ?? {};

const summaries = courses.map((course) => {
  const owned = ownsCourse(session.courses, course.slug);
  const total = lessonCount(course);
  const completed = owned ? completedInCourse(course, progress) : 0;
  const nextLesson =
    course.weeks
      .flatMap((week) => week.lessons)
      .find((lesson) => progress[lesson.id] !== 'done') ?? null;

  return {
    course,
    owned,
    total,
    completed,
    percent: total === 0 ? 0 : Math.round((completed / total) * 100),
    nextLesson,
  };
});

const ownedCount = summaries.filter((summary) => summary.owned).length;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`My courses · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="mx-auto max-w-5xl px-6 py-16">
      <header class="mb-12 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-gray-500">Dashboard</p>
          <h1 class="text-4xl font-bold">Welcome back, {user.certificateName ?? user.displayName}</h1>
          <p class="mt-2 text-gray-600">
            {user.admin ? 'Instructor access · ' : ''}Signed in with Discord as {user.username} ·
            {ownedCount === 1 ? ' 1 course' : ` ${ownedCount} courses`}
          </p>
        </div>
        <a class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium hover:bg-gray-100" href="/api/session">
          Session JSON
        </a>
      </header>

      {
        ownedCount === 0 && (
          <p class="mb-8 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
            Your Discord account does not have a course role yet. If you just bought a course, roles
            are usually applied within a few minutes — <a class="underline" href="/api/login?next=%2Fcourse">sign in again</a>
            once you have it, or <a class="underline" href="/buy">see the courses</a>.
          </p>
        )
      }

      <div class="grid gap-8 md:grid-cols-2">
        {
          summaries.map(({ course, owned, total, completed, percent, nextLesson }) => (
            <section class:list={['rounded-2xl border p-6 shadow-sm', owned ? 'border-gray-200' : 'border-dashed border-gray-300 bg-gray-50']}>
              <div class="mb-1 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-widest text-gray-500">
                <span>{course.level}</span>
                {owned ? (
                  <span class="rounded bg-green-100 px-2 py-0.5 text-green-800">Enrolled</span>
                ) : (
                  <span class="rounded bg-gray-200 px-2 py-0.5">Not enrolled</span>
                )}
              </div>

              <h2 class="text-2xl font-bold">{course.title}</h2>
              <p class="mt-2 text-gray-600">{course.tagline}</p>

              {owned && total > 0 && (
                <div class="mt-6">
                  <div class="mb-2 flex items-center justify-between text-sm text-gray-600">
                    <span data-progress-label>{completed} of {total} weeks complete</span>
                    <span data-progress-percent>{percent}%</span>
                  </div>
                  <div class="h-2 w-full overflow-hidden rounded-full bg-gray-200">
                    <div
                      class="h-full rounded-full bg-green-500 transition-all"
                      data-progress-bar
                      style={`width:${percent}%`}
                    />
                  </div>
                </div>
              )}

              <div class="mt-6 flex flex-wrap gap-3">
                {owned ? (
                  <>
                    {nextLesson ? (
                      <a class="rounded-lg bg-gray-900 px-4 py-2 font-medium text-white hover:bg-gray-700" href={nextLesson.href}>
                        {completed === 0 ? 'Start course' : 'Continue'}
                      </a>
                    ) : (
                      <a class="rounded-lg bg-gray-900 px-4 py-2 font-medium text-white hover:bg-gray-700" href={course.startHref}>
                        Revisit course
                      </a>
                    )}
                    <a class="rounded-lg border border-gray-300 px-4 py-2 font-medium hover:bg-gray-100" href={course.startHref}>
                      Curriculum
                    </a>
                  </>
                ) : (
                  <a class="rounded-lg bg-gray-900 px-4 py-2 font-medium text-white hover:bg-gray-700" href="/buy">
                    {course.title} — see details
                  </a>
                )}
              </div>

              {owned && course.weeks.length > 0 && (
                <ul class="mt-6 space-y-2 border-t border-gray-100 pt-4" data-course={course.slug}>
                  {course.weeks.map((week) => (
                    <li class="flex items-center gap-3">
                      <input
                        type="checkbox"
                        class="h-4 w-4 rounded border-gray-300"
                        data-lesson={week.lessons[0]?.id}
                        checked={week.lessons[0] ? progress[week.lessons[0].id] === 'done' : false}
                      />
                      <a class="text-sm hover:underline" href={week.lessons[0]?.href ?? '#'}>{week.title}</a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>

      {user.certificateName && (
        <section class="mt-12 rounded-2xl border border-gray-200 p-6">
          <h2 class="text-xl font-bold">Certificate</h2>
          <p class="mt-2 text-gray-600">
            Your certificate will be issued in the name <strong>{user.certificateName}</strong>.
            <a class="ml-2 underline" href="/welcome">Change it</a>
          </p>
        </section>
      )}
    </main>
    <Footer />

    <script>
      const checkboxes = document.querySelectorAll<HTMLInputElement>('[data-lesson]');

      function refresh() {
        for (const section of document.querySelectorAll<HTMLElement>('[data-course]')) {
          const boxes = section.querySelectorAll<HTMLInputElement>('[data-lesson]');
          const done = [...boxes].filter((box) => box.checked).length;
          const card = section.closest('section');
          if (!card) continue;
          const percent = boxes.length === 0 ? 0 : Math.round((done / boxes.length) * 100);
          const label = card.querySelector('[data-progress-label]');
          const percentLabel = card.querySelector('[data-progress-percent]');
          const bar = card.querySelector<HTMLElement>('[data-progress-bar]');
          if (label) label.textContent = `${done} of ${boxes.length} weeks complete`;
          if (percentLabel) percentLabel.textContent = `${percent}%`;
          if (bar) bar.style.width = `${percent}%`;
        }
      }

      for (const box of checkboxes) {
        box.addEventListener('change', async () => {
          const lessonId = box.dataset.lesson;
          if (!lessonId) return;
          box.disabled = true;
          try {
            const response = await fetch('/api/progress', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ lessonId, done: box.checked }),
            });
            if (!response.ok) box.checked = !box.checked;
          } catch {
            box.checked = !box.checked;
          } finally {
            box.disabled = false;
            refresh();
          }
        });
      }
    </script>
  </body>
</html>
