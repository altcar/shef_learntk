---
interface Props {
	name: string;
	linkedin?: string;
	github?: string;
	email?: string;
	image: string;
}

const { name, linkedin, github, email, image } = Astro.props;

const links = [
	email ? { href: email, label: `${name} email`, kind: "email" } : null,
	linkedin ? { href: linkedin, label: `${name} on LinkedIn`, kind: "linkedin" } : null,
	github ? { href: github, label: `${name} on GitHub`, kind: "github" } : null,
].filter(Boolean);
---

<div class="link-card">
	<a class="card-body" href={email ?? undefined}>
		<h2>{name}</h2>
		<img src={image} alt={`Portrait of ${name}`} loading="lazy" />
	</a>

	{
		links.length > 0 && (
			<div class="socials">
				{links.map((link) => (
					<a href={link!.href} aria-label={link!.label} rel="noopener noreferrer">
						{link!.kind === "linkedin" && (
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
								<path
									fill="currentColor"
									d="M22.2857 0H1.70893C0.766071 0 0 0.776786 0 1.73036V22.2696C0 23.2232 0.766071 24 1.70893 24H22.2857C23.2286 24 24 23.2232 24 22.2696V1.73036C24 0.776786 23.2286 0 22.2857 0ZM7.25357 20.5714H3.69643V9.11786H7.25893V20.5714H7.25357ZM5.475 7.55357C4.33393 7.55357 3.4125 6.62679 3.4125 5.49107C3.4125 4.35536 4.33393 3.42857 5.475 3.42857C6.61071 3.42857 7.5375 4.35536 7.5375 5.49107C7.5375 6.63214 6.61607 7.55357 5.475 7.55357ZM20.5875 20.5714H17.0304V15C17.0304 13.6714 17.0036 11.9625 15.1821 11.9625C13.3286 11.9625 13.0446 13.4089 13.0446 14.9036V20.5714H9.4875V9.11786H12.9V10.6821H12.9482C13.425 9.78214 14.5875 8.83393 16.3179 8.83393C19.9179 8.83393 20.5875 11.2071 20.5875 14.2929V20.5714Z"
								/>
							</svg>
						)}
						{link!.kind === "github" && (
							<svg viewBox="0 0 16 16" width="28" height="28" aria-hidden="true">
								<path
									fill="currentColor"
									d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
								/>
							</svg>
						)}
						{link!.kind === "email" && (
							<svg viewBox="0 0 24 24" width="28" height="28" fill="none" aria-hidden="true">
								<path
									d="M3 6.5A2.5 2.5 0 0 1 5.5 4h13A2.5 2.5 0 0 1 21 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z"
									stroke="currentColor"
									stroke-width="1.6"
								/>
								<path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
							</svg>
						)}
					</a>
				))}
			</div>
		)
	}
</div>

<style>
	.link-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: min(240px, 100%);
		padding: 0.9rem;
		border-radius: 10px;
		background: #23262d;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
		color: #fff;
		transition:
			background-color 0.3s ease,
			transform 0.3s ease;
	}

	.link-card:hover {
		background: #2d3039;
		transform: translateY(-2px);
	}

	.card-body {
		display: block;
		width: 100%;
		text-align: center;
		text-decoration: none;
		color: inherit;
	}

	.link-card h2 {
		margin: 0 0 0.6rem;
		color: #facc15;
		font-size: 1.5rem;
		line-height: 1.2;
	}

	.link-card img {
		display: block;
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: 8px;
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.socials a {
		display: inline-flex;
		color: #e5e7eb;
		transition: color 0.2s ease;
	}

	.socials a:hover {
		color: #fff;
	}

	@media (max-width: 720px) {
		.link-card {
			width: min(280px, 100%);
		}

		.link-card h2 {
			font-size: 1.35rem;
		}
	}
</style>
