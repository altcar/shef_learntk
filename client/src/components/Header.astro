---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import { loginUrl } from '../lib/access';

const session = Astro.locals.session;
const user = Astro.locals.user;
const avatar = user?.avatar ?? '/default-avatar.svg';
const needsOnboarding = Boolean(session) && !session?.certificateName;
const signInHref = loginUrl(`${Astro.url.pathname}${Astro.url.search}`);
---

<header>
	<nav>
		<div style="    display: flex;		align-items: center;">
			<Image src="/favicon.png" alt="" width="35" height="35" />
			<h2><a href="/">{SITE_TITLE}</a></h2>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/buy">Purchase</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			{user && <HeaderLink href="/course">My courses</HeaderLink>}
		</div>
		<div class="state">
			{
				user ? (
					<>
						<img src={avatar} alt="" width="40" height="40" referrerpolicy="no-referrer" />
						<div class="stateright">
							<div class="top123">
								<a href="/welcome">
									{needsOnboarding ? 'Finish your setup' : `Hi, ${session?.certificateName ?? user.displayName}`}
								</a>
							</div>
							<div class="btm123">
								<a href="/course">My courses</a>
								<a href="/api/logout">Log out</a>
							</div>
						</div>
					</>
				) : (
					<div class="stateright">
						<div class="top123"><a href={signInHref}>Please sign in</a></div>
						<div class="btm123"><a href={signInHref}>with Discord</a></div>
					</div>
				)
			}
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #fff;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
		white-space: nowrap;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
	}
	.internal-links a {
		transition: 0.5s;
	}
	
	.internal-links a:hover{
		 background:rgba(0,0,0, 0.1); 
		
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.state {
		display: flex;
		flex-direction: row;
		align-items: center;
		min-width: 0;
	}
	.stateright {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		min-width: 0;
	}
	.stateright a {
		white-space: nowrap;
	}
	.state img {
		margin-right: 20px;
		width: 40px !important;
		height: 40px !important;
		flex: 0 0 auto;
	}
	.state * {
		padding: 0;
	}
	.btm123 {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.75rem;
	}

	/* Narrow screens: brand and account on the first row, links on their own row. */
	@media (max-width: 720px) {
		header {
			padding: 0.25rem 0.75rem;
		}
		h2 {
			font-size: 0.95em;
		}
		nav a {
			padding: 0.6rem 0.5rem;
			font-size: 0.95rem;
		}
		.internal-links {
			order: 3;
			flex-basis: 100%;
			justify-content: flex-start;
			margin-top: 0.15rem;
			border-top: 1px solid rgb(var(--gray-light));
		}
		.internal-links a {
			padding: 0.6rem 0.5rem;
		}
		.state img {
			margin-right: 0.6rem;
			width: 32px !important;
			height: 32px !important;
		}
		.stateright {
			font-size: 0.85rem;
			line-height: 1.35;
		}
	}
</style>
